    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "ng-packagr": "^22.2.4",
    "package-version-info": "^0.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "quick-commitlint": "^0.1.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
